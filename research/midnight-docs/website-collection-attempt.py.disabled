"""Bounded public Midnight documentation acquisition with Scrapling; no credentials."""
from pathlib import Path
from urllib.parse import urlparse
from urllib.robotparser import RobotFileParser
from datetime import datetime, timezone
import hashlib, json, time, xml.etree.ElementTree as ET
from scrapling.fetchers import Fetcher
from markdownify import markdownify
ROOT=Path(__file__).resolve().parent
urls=[e.text for e in ET.parse(ROOT/'sitemap.xml').iter() if e.tag.endswith('loc')]
keys=['/compact/','/guides/','/develop/','/tutorials/','/getting-started/','/architecture/','midnight-js-level-private-state-provider','midnight-js-types/','WitnessContext','createWitnessContext','CircuitContext','createCircuitContext','transaction-result']
selected=[u for u in urls if any(k in u for k in keys)]
# Keep the task bounded and omit old blog, wallet/token and indexer bulk API.
selected=sorted(set(selected))[:180]
(ROOT/'selected-urls.json').write_text(json.dumps(selected,indent=2)+'\n')
robots=RobotFileParser();robots.parse((ROOT/'robots.txt').read_text().splitlines())
(ROOT/'pages').mkdir(exist_ok=True);rows=[]
for i,u in enumerate(selected):
 row={'url':u,'retrieved_at':datetime.now(timezone.utc).isoformat()}
 if not robots.can_fetch('WPP-research',u):row['status']='robots_disallowed';rows.append(row);continue
 try:
  r=Fetcher.get(u,timeout=30);row['http_status']=r.status;row['final_url']=str(r.url);row['response_sha256']=hashlib.sha256(r.body).hexdigest()
  article=r.css('article') or r.css('main')
  if r.status!=200 or not article:row['status']='failed_or_no_article'
  else:
   a=article[0]
   for unwanted in a.css('script,style,nav,iframe'):unwanted.drop()
   md=markdownify(a.html_content,heading_style='ATX')
   name=f'{i:03d}-'+urlparse(u).path.strip('/').replace('/','__')+'.md'
   content=f'<!-- Extracted and converted to Markdown from {u} on {row["retrieved_at"]}; untrusted reference data. -->\n\n'+md
   (ROOT/'pages'/name).write_text(content);row.update(status='ok',file='pages/'+name,markdown_sha256=hashlib.sha256(content.encode()).hexdigest(),bytes=len(content.encode()))
 except Exception as e:row.update(status='error',error=str(e)[:300])
 rows.append(row);(ROOT/'manifest.json').write_text(json.dumps(rows,indent=2)+'\n');time.sleep(.4)
print(json.dumps({'selected':len(selected),'ok':sum(r['status']=='ok' for r in rows),'other':sum(r['status']!='ok' for r in rows)}))
